# Free key, no credit card required: https://console.groq.com
GROQ_API_KEY=gsk_your_key_here

# Optional — durable rate limiting shared across serverless instances.
# Without these, /api/agent falls back to an in-memory rate limiter that
# still works but resets on cold start. Free tier: https://console.upstash.com
# (or add the "Upstash for Redis" integration from your Vercel project's
# Storage tab, which sets both automatically).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional — bot-abuse challenge on the audit form. Without this,
# /api/agent skips verification entirely (fails open). Free:
# https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
